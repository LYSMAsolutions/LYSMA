GITHUB_REPOSITORY="LYSMAsolutions/LYSMA"
GITHUB_BRANCH="main"
GITHUB_PUBLISH_BRANCH_PREFIX="super-admin/"
GITHUB_CREATE_PR="false"
GITHUB_DEPLOY_ON_BRANCH="false"
GITHUB_COMMIT_AUTHOR_NAME="LYSMA Super Admin"
GITHUB_COMMIT_AUTHOR_EMAIL="lysmasolutions+noreply@gmail.com"

