# A utiliser par les outils pour remonter messages et erreurs vers:
# POST /api/messages, POST /api/errors et POST /api/chatbox/log avec header x-lysma-inbound-secret.
# Les jokers sont acceptes: site-vitrine:* ou https://*.example.com.
CHATBOX_ALLOWED_ORIGINS="http://localhost:3021,http://localhost:3022,https://lysmasolutions.fr,https://www.lysmasolutions.fr,https://carrosserie-mounier.vercel.app,https://carrosserie-mounier-ruddy.vercel.app,https://carrosserie-mounier.fr,https://www.carrosserie-mounier.fr,https://livo-app.com,https://www.livo-app.com"
CHATBOX_ALLOWED_SOURCES="site-vitrine:*,app:livo-app"
CHATBOX_RATE_LIMIT_WINDOW_MS="60000"
CHATBOX_RATE_LIMIT_MAX="40"
RESEND_API_KEY=""
CHATBOX_BAD_ALERT_EMAIL_TO="lysmasolutions@gmail.com"
CHATBOX_BAD_ALERT_EMAIL_FROM="LYSMA Super Admin <notifications@lysmasolutions.fr>"
CHATBOX_ALERT_MODE="instant"
CHATBOX_DIGEST_HOUR="8"
CRON_SECRET=""

