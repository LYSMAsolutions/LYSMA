generator client {
  provider      = "prisma-client-js"
  output        = "../src/generated/prisma"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  nom          String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("admin_users")
}

model Client {
  id              String        @id @default(cuid())
  nom             String
  email           String        @unique
  telephone       String?
  societe         String?
  outil           String        @default("livo-app")
  statut          ClientStatut  @default(TRIAL)
  abonnement      String?       // starter / pro / entreprise
  trialDebutAt    DateTime?
  trialFinAt      DateTime?
  abonnementActif Boolean       @default(false)
  notes           String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  acces           Acces[]
  messages        Message[]

  @@map("clients")
}

model Acces {
  id            String    @id @default(cuid())
  clientId      String
  client        Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  email         String
  motDePasseTemp String?
  actif         Boolean   @default(true)
  premiereConnexion Boolean @default(false)
  createdAt     DateTime  @default(now())

  @@map("acces")
}

model Message {
  id        String        @id @default(cuid())
  clientId  String?
  client    Client?       @relation(fields: [clientId], references: [id])
  nom       String
  email     String
  societe   String?
  telephone String?
  outil     String        @default("livo-app")
  message   String
  statut    MessageStatut @default(NOUVEAU)
  reponse   String?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@map("messages")
}

model ChatLog {
  id                String      @id @default(cuid())
  source            String
  conversationId    String?
  visitorId         String?
  sessionId         String?
  questionSignature String?
  userName          String?
  userEmail         String?
  userPrompt        String
  assistantResponse String?
  quality           ChatQuality @default(UNKNOWN)
  qualityNotes      String?
  problemType       ChatProblemType @default(OTHER)
  reviewStatus      ChatReviewStatus @default(UNTREATED)
  metadata          Json?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  @@index([source])
  @@index([conversationId])
  @@index([source, visitorId])
  @@index([source, reviewStatus])
  @@index([problemType])
  @@index([questionSignature])
  @@index([createdAt])
  @@map("chat_logs")
}

model ChatboxUpdateNotification {
  id                String           @id @default(cuid())
  source            String
  visitorId         String?
  conversationId    String?
  questionSignature String?
  originalLogId     String?
  userPrompt        String
  improvedResponse  String
  status            ChatUpdateStatus @default(ANSWER_UPDATED)
  seen              Boolean          @default(false)
  seenAt            DateTime?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@index([source, visitorId, seen])
  @@index([conversationId])
  @@index([questionSignature])
  @@index([createdAt])
  @@map("chatbox_update_notifications")
}

model AuditLog {
  id         String   @id @default(cuid())
  outil      String
  cibleType  String
  cibleId    String?
  action     String
  statut     String   @default("SUCCESS")
  acteurId   String?
  acteurEmail String?
  resume     String?
  avant      Json?
  apres      Json?
  erreur     String?
  createdAt  DateTime @default(now())

  @@index([outil, cibleType, cibleId])
  @@index([createdAt])
  @@map("audit_logs")
}

model ErrorReport {
  id          String   @id @default(cuid())
  outil       String
  niveau      String   @default("ERROR")
  message     String
  stack       String?
  url         String?
  userAgent   String?
  contexte    Json?
  statut      String   @default("NOUVEAU")
  notes       String?
  resolution  String?
  resolvedAt  DateTime?
  resolvedBy  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([outil, statut])
  @@index([createdAt])
  @@map("error_reports")
}

model FinanceSettings {
  id                   String                       @id @default(cuid())
  urssafRate           Decimal                      @default(21.20) @db.Decimal(5, 2)
  vatRate              Decimal                      @default(20.00) @db.Decimal(5, 2)
  vatStatus            FinanceVatStatus             @default(ASSUJETTI)
  declarationFrequency FinanceDeclarationFrequency  @default(MENSUELLE)
  createdAt            DateTime                     @default(now())
  updatedAt            DateTime                     @updatedAt

  @@map("finance_settings")
}

model ShowcaseSiteFinance {
  id                       String                    @id @default(cuid())
  siteName                 String
  clientName               String
  clientCompany            String?
  publicLabel              String                    @default("Abonnement LYSMA - maintenance site vitrine")
  creationStandardPriceHT  Decimal                   @default(349.00) @db.Decimal(12, 2)
  creationSoldHT           Decimal                   @default(0) @db.Decimal(12, 2)
  creationStatus           ShowcaseCreationStatus    @default(CREATION_OFFERTE)
  maintenanceMonthlyHT     Decimal                   @default(19.00) @db.Decimal(12, 2)
  maintenanceStatus        ShowcaseMaintenanceStatus @default(MAINTENANCE_PAYANTE)
  domainCostHT             Decimal                   @default(0) @db.Decimal(12, 2)
  workspaceCostHT          Decimal                   @default(0) @db.Decimal(12, 2)
  otherMonthlyCostsHT      Decimal                   @default(0) @db.Decimal(12, 2)
  internalNotes            String?
  sageCustomerId           String?
  officialInvoiceNumber    String?
  officialPdfUrl           String?
  electronicInvoiceStatus  ElectronicInvoiceStatus   @default(A_PREPARER)
  platformProvider         String?
  platformInvoiceId        String?
  paymentStatus            FinancePaymentStatus      @default(EN_ATTENTE)
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt

  @@index([creationStatus, maintenanceStatus])
  @@map("showcase_site_finances")
}

model LysmaExpense {
  id            String           @id @default(cuid())
  name          String
  provider      String
  category      ExpenseCategory  @default(AUTRE)
  relatedTool   FinanceTool      @default(GLOBAL)
  amountHT      Decimal          @db.Decimal(12, 2)
  vatAmount     Decimal          @default(0) @db.Decimal(12, 2)
  amountTTC     Decimal          @db.Decimal(12, 2)
  frequency     FinanceFrequency @default(MENSUEL)
  startDate     DateTime
  renewalDate   DateTime?
  paymentMethod String?
  status        ExpenseStatus    @default(ACTIF)
  notes         String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@index([relatedTool, status])
  @@index([renewalDate])
  @@map("lysma_expenses")
}

model RevenueSubscription {
  id                         String           @id @default(cuid())
  clientName                 String
  clientCompany              String?
  tool                       FinanceTool
  planName                   String
  amountHT                   Decimal          @db.Decimal(12, 2)
  vatAmount                  Decimal          @default(0) @db.Decimal(12, 2)
  amountTTC                  Decimal          @db.Decimal(12, 2)
  frequency                  FinanceFrequency @default(MENSUEL)
  status                     RevenueStatus    @default(ACTIF)
  trialStartAt               DateTime?
  trialEndAt                 DateTime?
  startDate                  DateTime
  nextInvoiceAt              DateTime?
  nextPaymentAt              DateTime?
  gocardlessCustomerId       String?
  gocardlessMandateId        String?
  gocardlessSubscriptionId   String?
  sageCustomerId             String?
  createdAt                  DateTime         @default(now())
  updatedAt                  DateTime         @updatedAt
  payments                   FinancePayment[]

  @@index([tool, status])
  @@index([nextInvoiceAt])
  @@map("revenue_subscriptions")
}

model FinanceInvoice {
  id                      String                  @id @default(cuid())
  invoiceNumber           String                  @unique
  clientName              String
  clientCompany           String?
  tool                    FinanceTool
  amountHT                Decimal                 @db.Decimal(12, 2)
  vatAmount               Decimal                 @default(0) @db.Decimal(12, 2)
  amountTTC               Decimal                 @db.Decimal(12, 2)
  status                  FinanceInvoiceStatus    @default(BROUILLON)
  issueDate               DateTime
  dueDate                 DateTime?
  paidAt                  DateTime?
  pdfUrl                  String?
  sageInvoiceId           String?
  sageInvoiceStatus       String?
  electronicInvoiceStatus ElectronicInvoiceStatus @default(A_PREPARER)
  platformProvider        String?
  platformInvoiceId       String?
  createdAt               DateTime                @default(now())
  updatedAt               DateTime                @updatedAt
  payments                FinancePayment[]

  @@index([tool, status])
  @@index([issueDate])
  @@map("finance_invoices")
}

model FinancePayment {
  id                   String               @id @default(cuid())
  invoiceId            String?
  invoice              FinanceInvoice?      @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  subscriptionId       String?
  subscription         RevenueSubscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  amount               Decimal              @db.Decimal(12, 2)
  status               FinancePaymentStatus @default(EN_ATTENTE)
  method               String?
  gocardlessPaymentId  String?
  paidAt               DateTime?
  failedAt             DateTime?
  failureReason        String?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  @@index([status])
  @@index([paidAt])
  @@map("finance_payments")
}

model EchoChatMessage {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  role      String  @db.Text
  content   String  @db.Text
  model     String? @db.Text
  requestId String? @map("request_id") @db.Text
  metadata  Json    @default("{}") @db.JsonB

  memoryEntries EchoMemoryEntry[]
  hypotheses    EchoHypothesis[]
  decisions     EchoDecision[]

  @@index([createdAt(sort: Desc)], map: "idx_echo_chat_messages_created_at")
  @@index([requestId], map: "idx_echo_chat_messages_request_id")
  @@map("echo_chat_messages")
}

model EchoMemoryEntry {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  sourceMessageId String?          @map("source_message_id") @db.Uuid
  sourceMessage   EchoChatMessage? @relation(fields: [sourceMessageId], references: [id], onDelete: SetNull)

  source        String  @default("chat") @db.Text
  category      String  @default("general") @db.Text
  type          String  @db.Text
  sensitivity   String  @db.Text
  confidence    Decimal @default(0) @db.Decimal(3, 2)
  humanSummary  String  @map("human_summary") @db.Text
  sourceContent String? @map("source_content") @db.Text
  status        String  @default("en_validation") @db.Text
  validated     Boolean @default(false)
  links         Json    @default("[]") @db.JsonB
  metadata      Json    @default("{}") @db.JsonB

  @@index([createdAt(sort: Desc)], map: "idx_echo_memory_entries_created_at")
  @@index([type], map: "idx_echo_memory_entries_type")
  @@index([validated], map: "idx_echo_memory_entries_validated")
  @@index([sourceMessageId], map: "idx_echo_memory_entries_source_message_id")
  @@map("echo_memory_entries")
}

model EchoHypothesis {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  sourceMessageId String?          @map("source_message_id") @db.Uuid
  sourceMessage   EchoChatMessage? @relation(fields: [sourceMessageId], references: [id], onDelete: SetNull)

  hypothesis         String  @db.Text
  confidence         Decimal @default(0) @db.Decimal(3, 2)
  observedElements   String? @map("observed_elements") @db.Text
  validationQuestion String? @map("validation_question") @db.Text
  mathieuResponse    String? @map("mathieu_response") @db.Text
  status             String  @default("en_attente") @db.Text
  metadata           Json    @default("{}") @db.JsonB

  @@index([createdAt(sort: Desc)], map: "idx_echo_hypotheses_created_at")
  @@index([status], map: "idx_echo_hypotheses_status")
  @@index([sourceMessageId], map: "idx_echo_hypotheses_source_message_id")
  @@map("echo_hypotheses")
}

model EchoDecision {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  sourceMessageId String?          @map("source_message_id") @db.Uuid
  sourceMessage   EchoChatMessage? @relation(fields: [sourceMessageId], references: [id], onDelete: SetNull)

  decision  String    @db.Text
  reason    String?   @db.Text
  status    String    @default("actif") @db.Text
  decidedAt DateTime? @map("decided_at") @db.Timestamptz(6)
  metadata  Json      @default("{}") @db.JsonB

  @@index([createdAt(sort: Desc)], map: "idx_echo_decisions_created_at")
  @@index([status], map: "idx_echo_decisions_status")
  @@index([sourceMessageId], map: "idx_echo_decisions_source_message_id")
  @@map("echo_decisions")
}

enum ClientStatut {
  TRIAL
  ACTIF
  SUSPENDU
  RESILIE
}

enum MessageStatut {
  NOUVEAU
  LU
  TRAITE
}

enum ChatQuality {
  UNKNOWN
  GOOD
  BAD
}

enum ChatProblemType {
  DUPLICATE
  USER_REPORTED
  MISUNDERSTANDING
  LOST_CONTEXT
  USER_NEGATIVE_FEEDBACK
  FALLBACK
  OTHER
}

enum ChatReviewStatus {
  UNTREATED
  TREATED
}

enum ChatUpdateStatus {
  ANSWER_UPDATED
}

enum FinanceTool {
  GLOBAL
  LIVO
  PMA
  TRANSPORT
  SITE_VITRINE
  AUTRE
}

enum FinanceFrequency {
  MENSUEL
  ANNUEL
  PONCTUEL
}

enum RevenueStatus {
  ACTIF_PAYANT
  ACTIF
  ESSAI
  OFFERT
  SUSPENDU
  IMPAYE
  RESILIE
}

enum ShowcaseCreationStatus {
  CREATION_FACTUREE
  CREATION_OFFERTE
}

enum ShowcaseMaintenanceStatus {
  ABONNEMENT_ACTIF
  MAINTENANCE_OFFERTE
  MAINTENANCE_PAYANTE
}

enum ExpenseCategory {
  HEBERGEMENT
  DOMAINE
  IA
  COMPTABILITE
  PAIEMENT
  LOGICIEL
  API
  MATERIEL
  AUTRE
}

enum ExpenseStatus {
  ACTIF
  ARRETE
  A_VERIFIER
}

enum FinanceVatStatus {
  FRANCHISE
  ASSUJETTI
}

enum FinanceDeclarationFrequency {
  MENSUELLE
  TRIMESTRIELLE
}

enum FinanceInvoiceStatus {
  BROUILLON
  EMISE
  PAYEE
  EN_RETARD
  ANNULEE
}

enum FinancePaymentStatus {
  EN_ATTENTE
  PAYE
  ECHOUE
  REMBOURSE
  ANNULE
}

enum ElectronicInvoiceStatus {
  NON_CONCERNE
  A_PREPARER
  EN_ATTENTE
  TRANSMISE
  REJETEE
  ACCEPTEE
}
